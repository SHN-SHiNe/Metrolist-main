SHINE_HOST_PORT=8767
SHINE_DATA_PATH=/volume1/docker/shine-music/data
SHINE_MUSIC_PATH=/volume1/music
SHINE_LIBRARIES_PATH=/volume1/docker/shine-music/libraries
SHINE_CACHE_PATH=/volume1/docker/shine-music/cache
SHINE_TRASH_RETENTION_DAYS=30
SHINE_SCAN_ON_START=true
SHINE_ANALYSIS_ON_SCAN=true
SHINE_LOG_LEVEL=INFO
